# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Alpaca Trading API (Get from https://alpaca.markets/)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading for testing

# Email Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here  # Use App Password for Gmail
NOTIFICATION_EMAILS=["alert1@example.com","alert2@example.com"]
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email Notification Controls
ENABLE_EMAIL_NOTIFICATIONS=true
SEND_NEW_ARTICLES_ALERTS=true
SEND_HIGH_RELEVANCE_ALERTS=true
SEND_TRADING_SIGNAL_ALERTS=true
SEND_TRADE_EXECUTION_ALERTS=true
SEND_RISK_ALERTS=true
SEND_DAILY_HEALTH_REPORTS=true

# Database
DATABASE_URL=sqlite:///biotech_trader.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=biotech_trader.log

# Browser Settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30

# Risk Management
MAX_POSITION_SIZE=0.05  # 5% max per position
STOP_LOSS_PERCENTAGE=0.1  # 10% stop loss
TAKE_PROFIT_PERCENTAGE=0.2  # 20% take profit

# Sentiment Analysis Thresholds
SENTIMENT_THRESHOLD_POSITIVE=0.1
SENTIMENT_THRESHOLD_NEGATIVE=-0.1

# P-value Thresholds
P_VALUE_THRESHOLD_SIGNIFICANT=0.05
P_VALUE_THRESHOLD_HIGHLY_SIGNIFICANT=0.01

# Company Filters
MIN_MARKET_CAP=100000000
MIN_EMPLOYEE_COUNT=50

# Scraping Configuration
SCRAPE_INTERVAL_MINUTES=15