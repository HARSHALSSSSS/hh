# Alpaca Trading API Configuration
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Email Notifications (optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
NOTIFICATION_EMAILS=notify1@email.com,notify2@email.com

# Database Configuration (optional - defaults to SQLite)
DATABASE_URL=sqlite:///biotech_trader.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=biotech_trader.log

# Trading Risk Management
MAX_POSITION_SIZE=0.05
STOP_LOSS_PERCENTAGE=0.1
TAKE_PROFIT_PERCENTAGE=0.2
MAX_DAILY_TRADES=10

# Sentiment Analysis Thresholds
SENTIMENT_THRESHOLD_POSITIVE=0.1
SENTIMENT_THRESHOLD_NEGATIVE=-0.1

# P-value Thresholds
P_VALUE_THRESHOLD_SIGNIFICANT=0.05
P_VALUE_THRESHOLD_HIGHLY_SIGNIFICANT=0.01

# Company Filters
MIN_MARKET_CAP=100000000
MIN_EMPLOYEE_COUNT=50

# Scraping Configuration
SCRAPE_INTERVAL_MINUTES=15
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30